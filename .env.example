# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Which of these matter where:
#   local  — everything below
#   Vercel — DATABASE_URL, BETTER_AUTH_SECRET, and optionally ADMIN_EMAILS.
#            Generation is refused in production regardless of what is set
#            there (lib/access.js), so GENERATION_ENABLED is a local-only
#            knob and ADMIN_EMAILS grants nothing in production today — it
#            is set there only so the owner is already an admin when hosted
#            generation arrives.

# ---------------------------------------------------------------- required

# Neon Postgres. Source of truth for saved analyses AND for accounts.
# Same database locally and on Vercel, which is what makes a report
# generated on your Mac appear in production with no redeploy.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Signs session cookies. Any long random string: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes

# ---------------------------------------------------------------- local

# Where the app is reachable. Better Auth uses it for cookies and the
# origin check. On Vercel this is derived automatically from
# VERCEL_PROJECT_PRODUCTION_URL and should be left unset.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated. These accounts may run and refresh analyses. Everyone
# else can only read saved ones. Signing up never puts you on this list.
# Keep it out of source: this file is the placeholder, .env holds the real
# value, and .env is gitignored.
ADMIN_EMAILS=you@example.com

# Generation kill switch. Fails closed: only the literal "true" enables it.
# Set it to true only while you are actually generating — a run spends real
# LLM calls and real third-party API quota.
GENERATION_ENABLED=false

# ---------------------------------------------------------------- optional

# Path to the last30days plugin's last30days.py, used by the Reddit
# collector. Leave unset to auto-detect the newest version in
# ~/.claude/plugins/cache/last30days-skill/.
# LAST30DAYS_SCRIPT=/path/to/skills/last30days/scripts/last30days.py

# Raises the GitHub Search API limit from 10 to 30 requests/minute. Only
# used during generation, so it is not needed on Vercel.
# GITHUB_TOKEN=ghp_...
