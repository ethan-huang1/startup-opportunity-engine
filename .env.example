# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Which of these matter where:
#   local  — everything below
#   Vercel — DATABASE_URL, BETTER_AUTH_SECRET, ADMIN_EMAILS, and
#            GENERATION_ENABLED only if you actually want generation
#            attempted in production. Leave GENERATION_ENABLED unset there
#            and production serves saved reports only. Note that a
#            serverless runtime has no `claude` CLI, so generation there
#            answers 503 no-claude until hosted execution exists —
#            regardless of anyone's remaining free searches.

# ---------------------------------------------------------------- required

# Neon Postgres. Source of truth for saved analyses AND for accounts.
# Same database locally and on Vercel, which is what makes a report
# generated on your Mac appear in production with no redeploy.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Signs session cookies. Any long random string: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes

# ---------------------------------------------------------------- local

# Where the app is reachable. Better Auth uses it for cookies and the
# origin check. On Vercel this is derived automatically from
# VERCEL_PROJECT_PRODUCTION_URL and should be left unset.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated. These accounts are exempt from the three-free-searches
# meter, so you can test without burning an allowance. Everyone else —
# anonymous visitor or signed-in account alike — gets three new analyses,
# counted in Postgres (lib/usage.js). Unset is a safe default: it just
# means everyone is metered. Signing up never puts you on this list.
# Keep it out of source: this file is the placeholder, .env holds the real
# value, and .env is gitignored.
ADMIN_EMAILS=you@example.com

# Global generation kill switch, above everything else including admin and
# anyone's remaining free searches. Fails closed: only the literal "true"
# enables it, and it applies in every environment including production. Set it to true
# only while you are actually generating — a run spends real LLM calls and
# real third-party API quota. Read fresh on each request, so flipping it
# takes effect without a restart.
GENERATION_ENABLED=false

# ---------------------------------------------------------------- optional

# Path to the last30days plugin's last30days.py, used by the Reddit
# collector. Leave unset to auto-detect the newest version in
# ~/.claude/plugins/cache/last30days-skill/.
# LAST30DAYS_SCRIPT=/path/to/skills/last30days/scripts/last30days.py

# Raises the GitHub Search API limit from 10 to 30 requests/minute. Only
# used during generation, so it is not needed on Vercel.
# GITHUB_TOKEN=ghp_...
