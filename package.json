{
  "name": "startup-opportunity-engine",
  "version": "1.0.0",
  "description": "Evidence-backed startup opportunity discovery engine",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "test": "node --env-file-if-exists=.env --test \"tests/*.test.js\"",
    "test:browser": "node --env-file-if-exists=.env tests/browser.mjs",
    "migrate": "node --env-file=.env lib/migrate.js",
    "backfill": "node --env-file=.env scripts/backfill-runs-to-neon.mjs"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.1",
    "pg": "^8.23.0"
  }
}
